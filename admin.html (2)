<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NZAMA INVESTMENT | Admin Dashboard</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --bg:#080d1b;
    --panel:#11182b;
    --panel2:#151e34;
    --border:rgba(255,255,255,.08);
    --gold:#d7b35b;
    --gold2:#f0d58b;
    --text:#f7f8fb;
    --muted:#8995ad;
    --green:#39d98a;
    --red:#ff647c;
    --blue:#65a9ff;
}

body{
    font-family:Inter,Arial,Helvetica,sans-serif;
    background:
        radial-gradient(circle at 10% 0%,rgba(101,169,255,.08),transparent 30%),
        radial-gradient(circle at 90% 0%,rgba(215,179,91,.08),transparent 28%),
        var(--bg);
    color:var(--text);
    min-height:100vh;
}

/* TOP BAR */

.topbar{
    height:72px;
    padding:0 25px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--border);
    background:rgba(8,13,27,.92);
    backdrop-filter:blur(14px);
    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo-mark{
    width:40px;
    height:40px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,var(--gold),#8f6a22);
    color:#101010;
    font-weight:900;
    font-size:17px;
}

.logo-title{
    font-weight:900;
    letter-spacing:.7px;
    font-size:17px;
}

.logo-title span{
    color:var(--gold);
}

.logo-sub{
    color:var(--muted);
    font-size:10px;
    margin-top:2px;
}

.top-right{
    display:flex;
    align-items:center;
    gap:15px;
}

.admin-pill{
    border:1px solid rgba(215,179,91,.3);
    background:rgba(215,179,91,.08);
    color:var(--gold2);
    padding:8px 12px;
    border-radius:30px;
    font-size:12px;
    font-weight:700;
}

.logout{
    border:0;
    padding:10px 15px;
    border-radius:9px;
    background:#242e46;
    color:#fff;
    cursor:pointer;
    font-weight:700;
}

.logout:hover{
    background:#303c5a;
}

/* LAYOUT */

.layout{
    display:grid;
    grid-template-columns:235px 1fr;
    min-height:calc(100vh - 72px);
}

/* SIDEBAR */

.sidebar{
    border-right:1px solid var(--border);
    padding:25px 15px;
    background:rgba(10,15,30,.72);
}

.nav-title{
    color:#59657d;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1.5px;
    padding:0 12px 10px;
}

.nav-item{
    display:flex;
    align-items:center;
    gap:11px;
    width:100%;
    padding:12px;
    border-radius:10px;
    color:#aeb8cb;
    margin-bottom:5px;
    font-size:13px;
    cursor:pointer;
}

.nav-item.active{
    background:rgba(215,179,91,.12);
    color:var(--gold2);
}

.nav-item:hover{
    background:rgba(255,255,255,.05);
}

.nav-icon{
    width:23px;
    text-align:center;
}

/* MAIN */

.main{
    padding:28px;
    max-width:1500px;
    width:100%;
    margin:auto;
}

.page-heading{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:20px;
    margin-bottom:25px;
}

.page-heading h1{
    font-size:28px;
    letter-spacing:-.5px;
}

.page-heading p{
    color:var(--muted);
    font-size:13px;
    margin-top:6px;
}

.date-box{
    color:#929db3;
    font-size:12px;
}

/* NOTICE */

.notice{
    border:1px solid rgba(215,179,91,.2);
    background:linear-gradient(
        135deg,
        rgba(215,179,91,.08),
        rgba(255,255,255,.025)
    );
    padding:14px 17px;
    border-radius:13px;
    color:#c9d0df;
    font-size:12px;
    line-height:1.6;
    margin-bottom:22px;
}

.notice strong{
    color:var(--gold2);
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:22px;
}

.stat{
    padding:20px;
    border:1px solid var(--border);
    border-radius:15px;
    background:linear-gradient(
        145deg,
        rgba(21,30,52,.96),
        rgba(12,18,34,.96)
    );
}

.stat-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.stat-label{
    color:#8c98af;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.7px;
}

.stat-icon{
    width:34px;
    height:34px;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(215,179,91,.1);
    color:var(--gold2);
}

.stat-value{
    font-size:25px;
    font-weight:800;
    margin-top:12px;
}

.stat-small{
    color:#68748c;
    font-size:10px;
    margin-top:5px;
}

/* CONTENT GRID */

.content-grid{
    display:grid;
    grid-template-columns:350px 1fr;
    gap:20px;
}

/* CARDS */

.card{
    background:linear-gradient(
        145deg,
        rgba(17,24,43,.98),
        rgba(12,18,34,.98)
    );
    border:1px solid var(--border);
    border-radius:16px;
    padding:20px;
}

.card-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:16px;
}

.card-title{
    font-size:16px;
    font-weight:800;
}

.card-subtitle{
    color:#748097;
    font-size:11px;
    margin-top:4px;
}

/* SEARCH */

.search-wrap{
    position:relative;
    margin-bottom:15px;
}

.search-icon{
    position:absolute;
    left:12px;
    top:50%;
    transform:translateY(-50%);
    color:#68748b;
}

.search{
    width:100%;
    height:43px;
    padding:0 13px 0 36px;
    border:1px solid #28334e;
    border-radius:10px;
    background:#0b1223;
    color:#fff;
    outline:none;
}

.search:focus{
    border-color:rgba(215,179,91,.65);
}

/* CLIENT LIST */

.client-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    max-height:550px;
    overflow-y:auto;
    padding-right:3px;
}

.client{
    padding:13px;
    border:1px solid transparent;
    background:#0c1325;
    border-radius:11px;
    cursor:pointer;
    transition:.18s;
}

.client:hover{
    border-color:#313d5a;
    transform:translateY(-1px);
}

.client.active{
    border-color:rgba(215,179,91,.55);
    background:rgba(215,179,91,.08);
}

.client-row{
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:35px;
    height:35px;
    flex:none;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:linear-gradient(135deg,#293754,#151e34);
    color:var(--gold2);
    font-weight:800;
    font-size:12px;
}

.client-name{
    font-weight:700;
    font-size:13px;
}

.client-email{
    color:#76829a;
    font-size:10px;
    margin-top:3px;
    word-break:break-word;
}

.client-status{
    margin-left:auto;
    font-size:9px;
    padding:5px 7px;
    border-radius:20px;
    background:rgba(57,217,138,.09);
    color:#65e5a2;
}

.empty,
.loading{
    text-align:center;
    color:#69758c;
    padding:25px 10px;
    font-size:12px;
}

/* EDITOR */

.editor-header{
    display:flex;
    align-items:center;
    gap:13px;
    margin-bottom:22px;
}

.profile-avatar{
    width:52px;
    height:52px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,var(--gold),#85601d);
    color:#101010;
    font-size:18px;
    font-weight:900;
}

.editor-name{
    font-size:18px;
    font-weight:800;
}

.editor-email{
    color:#78849b;
    font-size:11px;
    margin-top:4px;
}

/* FORM */

.section{
    margin-top:23px;
}

.section-title{
    display:flex;
    align-items:center;
    gap:8px;
    color:var(--gold2);
    font-weight:800;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:.8px;
    border-bottom:1px solid var(--border);
    padding-bottom:10px;
    margin-bottom:14px;
}

.section-title span{
    width:4px;
    height:15px;
    border-radius:5px;
    background:var(--gold);
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:13px;
}

.field.full{
    grid-column:1/-1;
}

label{
    display:block;
    color:#8793aa;
    font-size:10px;
    margin-bottom:6px;
    text-transform:uppercase;
    letter-spacing:.4px;
}

input,
select{
    width:100%;
    height:42px;
    border:1px solid #28334e;
    border-radius:9px;
    background:#0a1121;
    color:#fff;
    padding:0 11px;
    outline:none;
    font-size:12px;
}

input:focus,
select:focus{
    border-color:rgba(215,179,91,.65);
}

input[readonly]{
    color:#9ba5b8;
    background:#0d1426;
}

.uid{
    height:auto;
    min-height:42px;
    display:flex;
    align-items:center;
    padding:10px;
    border:1px solid #28334e;
    border-radius:9px;
    background:#080e1d;
    color:#68748b;
    font-size:10px;
    word-break:break-all;
}

/* BALANCE CARDS */

.money-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:11px;
}

.money-card{
    padding:14px;
    border:1px solid #25304a;
    border-radius:11px;
    background:#0b1223;
}

.money-card label{
    margin-bottom:7px;
}

.money-card input{
    font-size:15px;
    font-weight:700;
}

/* TRANSACTIONS */

.transactions{
    display:flex;
    flex-direction:column;
    gap:9px;
}

.transaction{
    display:grid;
    grid-template-columns:1.3fr .8fr .8fr auto;
    gap:8px;
    padding:9px;
    background:#0b1223;
    border:1px solid #222d47;
    border-radius:10px;
}

.transaction button{
    border:0;
    background:#461925;
    color:#ff9aaa;
    border-radius:8px;
    padding:0 11px;
    cursor:pointer;
}

.transaction button:hover{
    background:#612131;
}

.add-transaction{
    border:1px dashed #3b4865;
    background:transparent;
    color:#9da8bb;
    padding:10px 14px;
    border-radius:9px;
    cursor:pointer;
    margin-top:10px;
    font-size:11px;
}

.add-transaction:hover{
    border-color:var(--gold);
    color:var(--gold2);
}

/* BUTTONS */

.actions{
    display:flex;
    gap:9px;
    margin-top:22px;
}

.save-btn{
    border:0;
    background:linear-gradient(135deg,var(--gold2),var(--gold));
    color:#111;
    padding:12px 20px;
    border-radius:9px;
    font-weight:800;
    cursor:pointer;
}

.save-btn:hover{
    filter:brightness(1.06);
}

.save-btn:disabled{
    opacity:.55;
    cursor:not-allowed;
}

.clear-btn{
    border:1px solid #303b56;
    background:#1a243b;
    color:#c6cedc;
    padding:12px 18px;
    border-radius:9px;
    cursor:pointer;
}

/* STATUS */

.status{
    margin-top:14px;
    padding:11px;
    border-radius:9px;
    font-size:11px;
    display:none;
}

.status.success{
    display:block;
    background:rgba(57,217,138,.1);
    border:1px solid rgba(57,217,138,.2);
    color:#75e8ad;
}

.status.error{
    display:block;
    background:rgba(255,100,124,.1);
    border:1px solid rgba(255,100,124,.2);
    color:#ff9aaa;
}

/* NO SELECTION */

.no-selection{
    min-height:580px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:#68748c;
}

.no-selection-icon{
    width:65px;
    height:65px;
    margin:0 auto 15px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#18223a;
    font-size:26px;
}

.no-selection h2{
    color:#b9c2d2;
    font-size:17px;
    margin-bottom:7px;
}

.no-selection p{
    max-width:300px;
    line-height:1.6;
    font-size:11px;
}

/* FOOTER */

.footer{
    margin-top:20px;
    color:#515d74;
    font-size:10px;
    text-align:center;
    padding:10px;
}

/* RESPONSIVE */

@media(max-width:1050px){

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .layout{
        grid-template-columns:190px 1fr;
    }

    .content-grid{
        grid-template-columns:300px 1fr;
    }

    .money-grid{
        grid-template-columns:1fr;
    }

}

@media(max-width:800px){

    .topbar{
        padding:0 14px;
    }

    .admin-pill{
        display:none;
    }

    .layout{
        display:block;
    }

    .sidebar{
        display:none;
    }

    .main{
        padding:18px 12px 30px;
    }

    .page-heading{
        align-items:flex-start;
        flex-direction:column;
    }

    .page-heading h1{
        font-size:23px;
    }

    .content-grid{
        grid-template-columns:1fr;
    }

    .client-list{
        max-height:300px;
    }

    .no-selection{
        min-height:300px;
    }

}

@media(max-width:550px){

    .stats{
        grid-template-columns:1fr 1fr;
        gap:9px;
    }

    .stat{
        padding:14px;
    }

    .stat-value{
        font-size:19px;
    }

    .stat-icon{
        width:28px;
        height:28px;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .field.full{
        grid-column:auto;
    }

    .transaction{
        grid-template-columns:1fr;
    }

    .transaction button{
        height:38px;
    }

    .actions{
        flex-direction:column;
    }

    .save-btn,
    .clear-btn{
        width:100%;
    }

    .logo-sub{
        display:none;
    }

}
</style>
</head>

<body>

<!-- =====================================================
     TOP BAR
===================================================== -->

<header class="topbar">

    <div class="logo">

        <div class="logo-mark">
            NZ
        </div>

        <div>

            <div class="logo-title">
                NZAMA <span>INVESTMENT</span>
            </div>

            <div class="logo-sub">
                Administration Portal
            </div>

        </div>

    </div>


    <div class="top-right">

        <div class="admin-pill">
            ● ADMINISTRATOR
        </div>

        <button
            class="logout"
            id="logoutBtn"
        >
            Logout
        </button>

    </div>

</header>


<!-- =====================================================
     LAYOUT
===================================================== -->

<div class="layout">


    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="nav-title">
            Administration
        </div>


        <div
            class="nav-item active"
            onclick="scrollToTop()"
        >
            <span class="nav-icon">▦</span>
            Dashboard
        </div>


        <div
            class="nav-item"
            onclick="focusSearch()"
        >
            <span class="nav-icon">⌕</span>
            Clients
        </div>


        <div
            class="nav-item"
            onclick="focusTransactions()"
        >
            <span class="nav-icon">↔</span>
            Transactions
        </div>


        <div class="nav-title" style="margin-top:25px;">
            Project
        </div>


        <div class="nav-item">
            <span class="nav-icon">◈</span>
            NZAMA Investment
        </div>


        <div class="nav-item">
            <span class="nav-icon">✓</span>
            Educational Mode
        </div>

    </aside>


    <!-- MAIN -->

    <main class="main">


        <!-- HEADING -->

        <div class="page-heading">

            <div>

                <h1>
                    Administration Dashboard
                </h1>

                <p>
                    Manage registered clients and educational portfolio data.
                </p>

            </div>


            <div
                class="date-box"
                id="currentDate"
            ></div>

        </div>


        <!-- NOTICE -->

        <div class="notice">

            <strong>Educational Project:</strong>
            This administrator interface is for the NZAMA INVESTMENT
            school/project demonstration. Portfolio figures, balances and
            transactions are illustrative and must not be represented as
            guaranteed investment returns or actual client funds.

        </div>


        <!-- STATS -->

        <section class="stats">


            <div class="stat">

                <div class="stat-top">

                    <div class="stat-label">
                        Total Clients
                    </div>

                    <div class="stat-icon">
                        ♙
                    </div>

                </div>

                <div
                    class="stat-value"
                    id="totalClients"
                >
                    0
                </div>

                <div class="stat-small">
                    Registered project users
                </div>

            </div>


            <div class="stat">

                <div class="stat-top">

                    <div class="stat-label">
                        Active Clients
                    </div>

                    <div class="stat-icon">
                        ✓
                    </div>

                </div>

                <div
                    class="stat-value"
                    id="activeClients"
                >
                    0
                </div>

                <div class="stat-small">
                    Accounts marked active
                </div>

            </div>


            <div class="stat">

                <div class="stat-top">

                    <div class="stat-label">
                        Illustrative Portfolio
                    </div>

                    <div class="stat-icon">
                        R
                    </div>

                </div>

                <div
                    class="stat-value"
                    id="totalPortfolio"
                >
                    R0
                </div>

                <div class="stat-small">
                    Project data only
                </div>

            </div>


            <div class="stat">

                <div class="stat-top">

                    <div class="stat-label">
                        Pending
                    </div>

                    <div class="stat-icon">
                        !
                    </div>

                </div>

                <div
                    class="stat-value"
                    id="pendingClients"
                >
                    0
                </div>

                <div class="stat-small">
                    Accounts awaiting action
                </div>

            </div>


        </section>


        <!-- CLIENT CONTENT -->

        <section class="content-grid">


            <!-- CLIENTS -->

            <div class="card">

                <div class="card-header">

                    <div>

                        <div class="card-title">
                            Registered Clients
                        </div>

                        <div class="card-subtitle">
                            Select a client to manage their profile.
                        </div>

                    </div>

                </div>


                <div class="search-wrap">

                    <span class="search-icon">
                        ⌕
                    </span>

                    <input
                        type="text"
                        id="searchInput"
                        class="search"
                        placeholder="Search clients..."
                    >

                </div>


                <div
                    id="clientList"
                    class="client-list"
                >

                    <div class="loading">
                        Loading clients...
                    </div>

                </div>

            </div>


            <!-- EDITOR -->

            <div class="card">

                <div
                    id="noSelection"
                    class="no-selection"
                >

                    <div>

                        <div class="no-selection-icon">
                            ♙
                        </div>

                        <h2>
                            Select a Client
                        </h2>

                        <p>
                            Choose a registered client from the
                            list to view and manage their educational
                            project profile.
                        </p>

                    </div>

                </div>


                <div
                    id="editor"
                    style="display:none;"
                >


                    <!-- CLIENT HEADER -->

                    <div class="editor-header">

                        <div
                            class="profile-avatar"
                            id="profileAvatar"
                        >
                            NZ
                        </div>

                        <div>

                            <div
                                class="editor-name"
                                id="editorName"
                            >
                                Client
                            </div>

                            <div
                                class="editor-email"
                                id="editorEmail"
                            >
                                —
                            </div>

                        </div>

                    </div>


                    <!-- PROFILE -->

                    <div class="section">

                        <div class="section-title">
                            <span></span>
                            Client Information
                        </div>


                        <div class="form-grid">


                            <div class="field">

                                <label>
                                    Full Name
                                </label>

                                <input
                                    id="clientName"
                                    type="text"
                                    readonly
                                >

                            </div>


                            <div class="field">

                                <label>
                                    Email
                                </label>

                                <input
                                    id="clientEmail"
                                    type="email"
                                    readonly
                                >

                            </div>


                            <div class="field">

                                <label>
                                    Phone
                                </label>

                                <input
                                    id="clientPhone"
                                    type="text"
                                    readonly
                                >

                            </div>


                            <div class="field">

                                <label>
                                    Account Status
                                </label>

                                <select id="accountStatus">

                                    <option value="active">
                                        Active
                                    </option>

                                    <option value="pending">
                                        Pending
                                    </option>

                                    <option value="suspended">
                                        Suspended
                                    </option>

                                    <option value="closed">
                                        Closed
                                    </option>

                                </select>

                            </div>


                            <div class="field full">

                                <label>
                                    Firebase User ID
                                </label>

                                <div
                                    id="clientUid"
                                    class="uid"
                                ></div>

                            </div>


                        </div>

                    </div>


                    <!-- PORTFOLIO -->

                    <div class="section">

                        <div class="section-title">
                            <span></span>
                            Portfolio
                        </div>


                        <div class="form-grid">


                            <div class="field">

                                <label>
                                    Investment Plan
                                </label>

                                <select id="plan">

                                    <option value="">
                                        Select Plan
                                    </option>

                                    <option value="Basic">
                                        Basic
                                    </option>

                                    <option value="Advanced">
                                        Advanced
                                    </option>

                                    <option value="Premium">
                                        Premium
                                    </option>

                                    <option value="Elite">
                                        Elite
                                    </option>

                                </select>

                            </div>


                            <div class="field">

                                <label>
                                    Portfolio Status
                                </label>

                                <select id="portfolioStatus">

                                    <option value="active">
                                        Active
                                    </option>

                                    <option value="pending">
                                        Pending
                                    </option>

                                    <option value="completed">
                                        Completed
                                    </option>

                                    <option value="closed">
                                        Closed
                                    </option>

                                </select>

                            </div>


                        </div>


                        <div
                            class="money-grid"
                            style="margin-top:13px;"
                        >


                            <div class="money-card">

                                <label>
                                    Total Invested
                                </label>

                                <input
                                    id="totalInvested"
                                    type="number"
                                    min="0"
                                    step="0.01"
                                    value="0"
                                >

                            </div>


                            <div class="money-card">

                                <label>
                                    Current Value
                                </label>

                                <input
                                    id="currentValue"
                                    type="number"
                                    min="0"
                                    step="0.01"
                                    value="0"
                                >

                            </div>


                            <div class="money-card">

                                <label>
                                    Account Balance
                                </label>

                                <input
                                    id="accountBalance"
                                    type="number"
                                    min="0"
                                    step="0.01"
                                    value="0"
                                >

                            </div>


                        </div>

                    </div>


                    <!-- TRANSACTIONS -->

                    <div
                        class="section"
                        id="transactionSection"
                    >

                        <div class="section-title">
                            <span></span>
                            Transactions
                        </div>


                        <div
                            id="transactions"
                            class="transactions"
                        ></div>


                        <button
                            type="button"
                            class="add-transaction"
                            id="addTransactionBtn"
                        >
                            + Add Transaction
                        </button>

                    </div>


                    <!-- ACTIONS -->

                    <div class="actions">

                        <button
                            type="button"
                            class="save-btn"
                            id="saveBtn"
                        >
                            Save Client
                        </button>


                        <button
                            type="button"
                            class="clear-btn"
                            id="clearBtn"
                        >
                            Clear
                        </button>

                    </div>


                    <div
                        id="statusMessage"
                        class="status"
                    ></div>


                </div>

            </div>


        </section>


        <div class="footer">
            NZAMA INVESTMENT • Administration Portal • Educational Project
        </div>


    </main>

</div>


<script type="module">

/* =========================================================
   FIREBASE IMPORTS
========================================================= */

import {
    initializeApp
} from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";

import {
    getAuth,
    onAuthStateChanged,
    signOut
} from "https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js";

import {
    getDatabase,
    ref,
    get,
    update,
    serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.19.0/firebase-database.js";


/* =========================================================
   FIREBASE CONFIG
========================================================= */

const firebaseConfig = {

    apiKey:
        "AIzaSyD7McDVKPQ5mZlcVBtmixK3Er9288rbeww",

    authDomain:
        "nzama-investment-2026.firebaseapp.com",

    databaseURL:
        "https://nzama-investment-2026-default-rtdb.firebaseio.com",

    projectId:
        "nzama-investment-2026",

    storageBucket:
        "nzama-investment-2026.firebasestorage.app",

    messagingSenderId:
        "1050465478535",

    appId:
        "1:1050465478535:web:dbdee6dfe598b644399522",

    measurementId:
        "G-LEPZ7W5HG8"

};


/* =========================================================
   FIREBASE INITIALIZATION
========================================================= */

const app =
    initializeApp(firebaseConfig);

const auth =
    getAuth(app);

const db =
    getDatabase(app);


/* =========================================================
   ADMIN UID
========================================================= */

const ADMIN_UID =
    "J4yuLwlZ9zRPcqA9oakr2uKNfoh1";


/* =========================================================
   ELEMENTS
========================================================= */

const clientList =
    document.getElementById("clientList");

const searchInput =
    document.getElementById("searchInput");

const noSelection =
    document.getElementById("noSelection");

const editor =
    document.getElementById("editor");

const logoutBtn =
    document.getElementById("logoutBtn");

const saveBtn =
    document.getElementById("saveBtn");

const clearBtn =
    document.getElementById("clearBtn");

const addTransactionBtn =
    document.getElementById("addTransactionBtn");

const transactionsBox =
    document.getElementById("transactions");

const statusMessage =
    document.getElementById("statusMessage");


/* =========================================================
   STATE
========================================================= */

let clients = {};

let selectedUid = null;


/* =========================================================
   DATE
========================================================= */

document.getElementById("currentDate").textContent =
    new Intl.DateTimeFormat("en-ZA", {
        dateStyle:"full"
    }).format(new Date());


/* =========================================================
   AUTHENTICATION
========================================================= */

onAuthStateChanged(auth, async (user) => {

    if (!user) {

        window.location.href =
            "login.html";

        return;
    }


    console.log(
        "Authenticated UID:",
        user.uid
    );


    if (user.uid !== ADMIN_UID) {

        alert(
            "Access denied. Please log in using the administrator account."
        );

        await signOut(auth);

        window.location.href =
            "login.html";

        return;
    }


    await loadClients();

});


/* =========================================================
   LOAD CLIENTS
========================================================= */

async function loadClients() {

    clientList.innerHTML = `
        <div class="loading">
            Loading clients...
        </div>
    `;


    try {

        const snapshot =
            await get(
                ref(db, "users")
            );


        if (!snapshot.exists()) {

            clients = {};

            updateStatistics();

            clientList.innerHTML = `
                <div class="empty">
                    No registered clients found.
                </div>
            `;

            return;
        }


        clients =
            snapshot.val() || {};


        updateStatistics();

        renderClients();


    } catch (error) {

        console.error(
            "Could not load clients:",
            error
        );


        clientList.innerHTML = `
            <div class="empty">
                Could not load clients.<br><br>
                ${escapeHtml(error.message)}
            </div>
        `;

    }

}


/* =========================================================
   STATISTICS
========================================================= */

function updateStatistics() {

    const entries =
        Object.entries(clients)
            .filter(([uid, data]) => {

                return data &&
                    data.role !== "admin";

            });


    const total =
        entries.length;


    const active =
        entries.filter(
            ([uid, data]) =>
                String(
                    data.accountStatus || "active"
                ).toLowerCase() === "active"
        ).length;


    const pending =
        entries.filter(
            ([uid, data]) =>
                String(
                    data.accountStatus || ""
                ).toLowerCase() === "pending"
        ).length;


    let portfolioTotal = 0;


    entries.forEach(([uid, data]) => {

        const portfolio =
            data.portfolio || {};


        portfolioTotal +=
            Number(
                portfolio.currentValue ??
                portfolio.totalInvested ??
                0
            ) || 0;

    });


    document.getElementById(
        "totalClients"
    ).textContent =
        total;


    document.getElementById(
        "activeClients"
    ).textContent =
        active;


    document.getElementById(
        "pendingClients"
    ).textContent =
        pending;


    document.getElementById(
        "totalPortfolio"
    ).textContent =
        formatMoney(portfolioTotal);

}


/* =========================================================
   RENDER CLIENT LIST
========================================================= */

function renderClients() {

    const search =
        searchInput.value
            .trim()
            .toLowerCase();


    const entries =
        Object.entries(clients)
            .filter(([uid, data]) => {

                if (!data) {
                    return false;
                }


                if (data.role === "admin") {
                    return false;
                }


                const name =
                    String(data.name || "")
                        .toLowerCase();


                const email =
                    String(data.email || "")
                        .toLowerCase();


                return (
                    name.includes(search) ||
                    email.includes(search)
                );

            });


    if (entries.length === 0) {

        clientList.innerHTML = `
            <div class="empty">
                No clients found.
            </div>
        `;

        return;
    }


    clientList.innerHTML = "";


    entries.forEach(([uid, data]) => {

        const item =
            document.createElement("div");


        item.className =
            "client" +
            (
                uid === selectedUid
                    ? " active"
                    : ""
            );


        const name =
            data.name ||
            "Unnamed Client";


        const initials =
            getInitials(name);


        const status =
            data.accountStatus ||
            "active";


        item.innerHTML = `

            <div class="client-row">

                <div class="avatar">
                    ${escapeHtml(initials)}
                </div>

                <div style="min-width:0;flex:1;">

                    <div class="client-name">
                        ${escapeHtml(name)}
                    </div>

                    <div class="client-email">
                        ${escapeHtml(
                            data.email ||
                            "No email"
                        )}
                    </div>

                </div>

                <div class="client-status">
                    ${escapeHtml(status)}
                </div>

            </div>

        `;


        item.addEventListener(
            "click",
            () => selectClient(uid)
        );


        clientList.appendChild(item);

    });

}


/* =========================================================
   SELECT CLIENT
========================================================= */

function selectClient(uid) {

    selectedUid = uid;


    const data =
        clients[uid];


    if (!data) {
        return;
    }


    noSelection.style.display =
        "none";

    editor.style.display =
        "block";


    const name =
        data.name ||
        "Unnamed Client";


    document.getElementById(
        "profileAvatar"
    ).textContent =
        getInitials(name);


    document.getElementById(
        "editorName"
    ).textContent =
        name;


    document.getElementById(
        "editorEmail"
    ).textContent =
        data.email || "";


    document.getElementById(
        "clientName"
    ).value =
        name;


    document.getElementById(
        "clientEmail"
    ).value =
        data.email || "";


    document.getElementById(
        "clientPhone"
    ).value =
        data.phone || "";


    document.getElementById(
        "accountStatus"
    ).value =
        data.accountStatus ||
        "active";


    document.getElementById(
        "clientUid"
    ).textContent =
        uid;


    const portfolio =
        data.portfolio || {};


    document.getElementById(
        "plan"
    ).value =
        portfolio.plan || "";


    document.getElementById(
        "portfolioStatus"
    ).value =
        portfolio.status ||
        "active";


    document.getElementById(
        "totalInvested"
    ).value =
        portfolio.totalInvested ??
        0;


    document.getElementById(
        "currentValue"
    ).value =
        portfolio.currentValue ??
        0;


    document.getElementById(
        "accountBalance"
    ).value =
        data.accountBalance ??
        data.balance ??
        portfolio.accountBalance ??
        0;


    loadTransactions(
        data.transactions
    );


    hideStatus();

    renderClients();

}


/* =========================================================
   TRANSACTIONS
========================================================= */

function loadTransactions(data) {

    transactionsBox.innerHTML = "";


    if (!data) {
        return;
    }


    let list = [];


    if (Array.isArray(data)) {

        list = data;

    } else {

        list =
            Object.values(data);

    }


    list.forEach(
        transaction =>
            addTransactionRow(transaction)
    );

}


function addTransactionRow(data = {}) {

    const row =
        document.createElement("div");


    row.className =
        "transaction";


    row.innerHTML = `

        <input
            type="text"
            class="tx-description"
            placeholder="Description"
            value="${escapeAttribute(
                data.description || ""
            )}"
        >

        <input
            type="number"
            class="tx-amount"
            placeholder="Amount"
            min="0"
            step="0.01"
            value="${data.amount ?? ""}"
        >

        <input
            type="date"
            class="tx-date"
            value="${escapeAttribute(
                data.date || ""
            )}"
        >

        <button
            type="button"
            class="remove-tx"
        >
            Remove
        </button>

    `;


    row.querySelector(
        ".remove-tx"
    ).addEventListener(
        "click",
        () => row.remove()
    );


    transactionsBox.appendChild(row);

}


/* =========================================================
   SAVE
========================================================= */

saveBtn.addEventListener(
    "click",
    async () => {

        if (!selectedUid) {

            showStatus(
                "Please select a client first.",
                "error"
            );

            return;
        }


        saveBtn.disabled = true;

        saveBtn.textContent =
            "Saving...";


        try {

            const portfolio = {

                plan:
                    document.getElementById(
                        "plan"
                    ).value,

                status:
                    document.getElementById(
                        "portfolioStatus"
                    ).value,

                totalInvested:
                    Number(
                        document.getElementById(
                            "totalInvested"
                        ).value
                    ) || 0,

                currentValue:
                    Number(
                        document.getElementById(
                            "currentValue"
                        ).value
                    ) || 0

            };


            const transactions = [];


            document
                .querySelectorAll(
                    "#transactions .transaction"
                )
                .forEach(row => {

                    const description =
                        row.querySelector(
                            ".tx-description"
                        ).value.trim();


                    const amount =
                        Number(
                            row.querySelector(
                                ".tx-amount"
                            ).value
                        ) || 0;


                    const date =
                        row.querySelector(
                            ".tx-date"
                        ).value;


                    if (
                        description ||
                        amount ||
                        date
                    ) {

                        transactions.push({

                            description:
                                description,

                            amount:
                                amount,

                            date:
                                date

                        });

                    }

                });


            const accountBalance =
                Number(
                    document.getElementById(
                        "accountBalance"
                    ).value
                ) || 0;


            const accountStatus =
                document.getElementById(
                    "accountStatus"
                ).value;


            const updates = {};


            updates[
                `users/${selectedUid}/accountStatus`
            ] =
                accountStatus;


            updates[
                `users/${selectedUid}/accountBalance`
            ] =
                accountBalance;


            updates[
                `users/${selectedUid}/portfolio`
            ] =
                portfolio;


            updates[
                `users/${selectedUid}/transactions`
            ] =
                transactions;


            updates[
                `users/${selectedUid}/updatedAt`
            ] =
                serverTimestamp();


            await update(
                ref(db),
                updates
            );


            clients[selectedUid] = {

                ...clients[selectedUid],

                accountStatus:
                    accountStatus,

                accountBalance:
                    accountBalance,

                portfolio:
                    portfolio,

                transactions:
                    transactions

            };


            updateStatistics();

            renderClients();


            showStatus(
                "Client information saved successfully.",
                "success"
            );


        } catch (error) {

            console.error(
                "Save error:",
                error
            );


            showStatus(
                "Could not save client: " +
                error.message,
                "error"
            );


        } finally {

            saveBtn.disabled = false;

            saveBtn.textContent =
                "Save Client";

        }

    }
);


/* =========================================================
   ADD TRANSACTION
========================================================= */

addTransactionBtn.addEventListener(
    "click",
    () => addTransactionRow()
);


/* =========================================================
   SEARCH
========================================================= */

searchInput.addEventListener(
    "input",
    renderClients
);


/* =========================================================
   CLEAR
========================================================= */

clearBtn.addEventListener(
    "click",
    () => {

        selectedUid = null;

        editor.style.display =
            "none";

        noSelection.style.display =
            "flex";

        hideStatus();

        renderClients();

    }
);


/* =========================================================
   LOGOUT
========================================================= */

logoutBtn.addEventListener(
    "click",
    async () => {

        try {

            await signOut(auth);

            window.location.href =
                "login.html";

        } catch (error) {

            console.error(
                "Logout error:",
                error
            );

        }

    }
);


/* =========================================================
   HELPERS
========================================================= */

function showStatus(
    message,
    type
) {

    statusMessage.textContent =
        message;

    statusMessage.className =
        "status " + type;

}


function hideStatus() {

    statusMessage.textContent =
        "";

    statusMessage.className =
        "status";

}


function formatMoney(amount) {

    return "R" +
        Number(amount || 0)
            .toLocaleString(
                "en-ZA",
                {
                    minimumFractionDigits:0,
                    maximumFractionDigits:2
                }
            );

}


function getInitials(name) {

    const words =
        String(name)
            .trim()
            .split(/\s+/)
            .filter(Boolean);


    if (!words.length) {
        return "NZ";
    }


    if (words.length === 1) {

        return words[0]
            .substring(0,2)
            .toUpperCase();

    }


    return (
        words[0][0] +
        words[words.length - 1][0]
    ).toUpperCase();

}


function escapeHtml(value) {

    return String(value)
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");

}


function escapeAttribute(value) {

    return escapeHtml(value);

}


/* =========================================================
   SIDEBAR ACTIONS
========================================================= */

window.scrollToTop = function(){

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

};


window.focusSearch = function(){

    document
        .getElementById("searchInput")
        .focus();

};


window.focusTransactions = function(){

    document
        .getElementById("transactionSection")
        .scrollIntoView({
            behavior:"smooth"
        });

};

</script>

