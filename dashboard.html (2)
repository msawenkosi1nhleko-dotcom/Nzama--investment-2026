    }

    if(
        clean === "inactive" ||
        clean === "disabled" ||
        clean === "suspended"
    ){
        css = "inactive";
    }

    return `
        <span class="status ${css}">
            ${escapeHTML(status || "active")}
        </span>
    `;

}


function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* ================= TRANSACTIONS ================= */

function renderTransactions(transactions){

    transactionList.innerHTML = "";

    if(!transactions){

        transactionList.innerHTML = `
            <div class="empty">
                No transactions available.
            </div>
        `;

        return;
    }


    let items = [];


    if(Array.isArray(transactions)){

        items = transactions.map((item,index) => {

            return {
                id:index,
                ...(item || {})
            };

        });

    }else if(
        typeof transactions === "object"
    ){

        items = Object.entries(transactions)
            .map(([id,item]) => {

                return {
                    id:id,
                    ...(item || {})
                };

            });

    }


    if(items.length === 0){

        transactionList.innerHTML = `
            <div class="empty">
                No transactions available.
            </div>
        `;

        return;
    }


    items.sort((a,b) => {

        const dateA =
            new Date(a.date || a.createdAt || 0).getTime();

        const dateB =
            new Date(b.date || b.createdAt || 0).getTime();

        return dateB - dateA;

    });


    items.forEach(item => {

        const amount =
            Number(item.amount || 0);

        const positive =
            amount >= 0;

        const transaction =
            document.createElement("div");

        transaction.className = "transaction";

        transaction.innerHTML = `

            <div>

                <div class="transaction-name">
                    ${escapeHTML(
                        item.description ||
                        item.name ||
                        item.type ||
                        "Transaction"
                    )}
                </div>

                <div class="transaction-date">
                    ${formatDate(
                        item.date ||
                        item.createdAt
                    )}
                </div>

            </div>

            <div class="transaction-amount ${
                positive ? "positive" : "negative"
            }">

                ${positive ? "+" : ""}
                ${formatMoney(amount)}

            </div>

        `;

        transactionList.appendChild(transaction);

    });

}


/* ================= LOAD CLIENT ================= */

async function loadClient(user){

    try{

        const userRef =
            ref(db,"users/" + user.uid);

        const snapshot =
            await get(userRef);


        if(!snapshot.exists()){

            throw new Error(
                "Your Firebase user profile could not be found."
            );

        }


        const data =
            snapshot.val() || {};


        /* PROFILE */

        const name =
            data.name ||
            user.displayName ||
            "Client";


        const email =
            data.email ||
            user.email ||
            "—";


        const phone =
            data.phone ||
            "—";


        const role =
            data.role ||
            "client";


        const accountStatus =
            data.accountStatus ||
            "active";


        /* PROFILE DISPLAY */

        welcomeName.textContent =
            name.split(" ")[0] || name;

        profileName.textContent =
            name;

        profileRole.textContent =
            role === "admin"
            ? "Administrator Account"
            : "Client Account";


        clientName.textContent =
            name;

        clientEmail.textContent =
            email;

        clientPhone.textContent =
            phone;

        clientRole.textContent =
            role;

        clientStatus.innerHTML =
            statusHTML(accountStatus);

        firebaseUid.textContent =
            user.uid;


        avatar.textContent =
            getInitials(name);


        /* MEMBER SINCE */

        const createdAt =
            data.createdAt;

        memberSince.textContent =
            formatDate(createdAt);


        /* PORTFOLIO */

        const portfolio =
            data.portfolio || {};


        const plan =
            portfolio.plan ||
            "Not assigned";


        const invested =
            portfolio.totalInvested ||
            0;


        const currentValue =
            portfolio.currentValue ||
            0;


        const pStatus =
            portfolio.status ||
            "Not available";


        /* BALANCE */

        const balance =
            data.accountBalance ??
            data.balance ??
            portfolio.accountBalance ??
            0;


        /* DISPLAY PORTFOLIO */

        summaryPortfolio.textContent =
            formatMoney(currentValue);

        summaryBalance.textContent =
            formatMoney(balance);


        portfolioValue.textContent =
            formatMoney(currentValue);

        portfolioPlan.textContent =
            "Plan: " + plan;

        totalInvested.textContent =
            formatMoney(invested);

        portfolioStatus.innerHTML =
            statusHTML(pStatus);


        accountStatusSummary.innerHTML =
            statusHTML(accountStatus);


        /* TRANSACTIONS */

        renderTransactions(
            data.transactions
        );


        console.log(
            "NZAMA INVESTMENT client loaded:",
            user.uid
        );


    }catch(error){

        console.error(
            "Dashboard error:",
            error
        );


        alert(
            "Could not load your client information. " +
            "Please check your Firebase Realtime Database rules."
        );

    }finally{

        loadingScreen.style.display =
            "none";

    }

}


