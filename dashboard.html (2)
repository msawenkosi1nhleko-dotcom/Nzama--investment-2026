    align-items:center;
    gap:12px;
    text-decoration:none;
    color:white;
}

.logo{
    width:44px;
    height:44px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:var(--navy);
    font-weight:900;
    font-size:17px;
    box-shadow:0 5px 15px rgba(214,173,85,.25);
}

.brand-text{
    line-height:1.1;
}

.brand-name{
    font-size:18px;
    font-weight:900;
    letter-spacing:.7px;
}

.brand-sub{
    color:#b9c2d0;
    font-size:10px;
    letter-spacing:1.8px;
    margin-top:4px;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:6px;
}

.nav-links a,
.logout-btn{
    border:0;
    background:transparent;
    color:#dfe6ef;
    text-decoration:none;
    padding:11px 15px;
    border-radius:9px;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.nav-links a:hover,
.logout-btn:hover{
    background:rgba(255,255,255,.08);
    color:white;
}

.nav-links a.active{
    background:rgba(214,173,85,.15);
    color:var(--gold2);
}

.logout-btn{
    border:1px solid rgba(214,173,85,.55);
    color:var(--gold2);
}

.menu-btn{
    display:none;
    border:1px solid rgba(255,255,255,.15);
    background:transparent;
    color:white;
    border-radius:9px;
    padding:9px 12px;
    font-size:20px;
    cursor:pointer;
}

/* ================= PAGE ================= */

.page{
    max-width:1250px;
    margin:auto;
    padding:35px 22px 60px;
}

.hero{
    background:
        linear-gradient(120deg,rgba(7,20,38,.98),rgba(13,31,56,.94));
    color:white;
    border-radius:20px;
    padding:32px;
    margin-bottom:24px;
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
}

.hero:after{
    content:"";
    position:absolute;
    width:280px;
    height:280px;
    border-radius:50%;
    border:1px solid rgba(214,173,85,.15);
    right:-100px;
    top:-100px;
}

.hero-content{
    position:relative;
    z-index:2;
}

.eyebrow{
    color:var(--gold2);
    font-size:12px;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:9px;
}

.hero h1{
    font-size:34px;
    line-height:1.2;
    margin-bottom:9px;
}

.hero p{
    color:#c9d2df;
    max-width:680px;
    line-height:1.6;
}

/* ================= NOTICE ================= */

.notice{
    background:#fffaf0;
    border:1px solid #ead8a9;
    border-left:5px solid var(--gold);
    padding:17px 19px;
    border-radius:13px;
    margin-bottom:25px;
    color:#5e4a20;
    line-height:1.55;
    font-size:13px;
}

/* ================= SUMMARY CARDS ================= */

.summary-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-bottom:25px;
}

.summary-card{
    background:white;
    border:1px solid var(--border);
    border-radius:16px;
    padding:23px;
    box-shadow:var(--shadow);
}

.summary-label{
    color:var(--muted);
    font-size:12px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.8px;
    margin-bottom:10px;
}

.summary-value{
    font-size:28px;
    font-weight:900;
    color:var(--navy);
}

.summary-small{
    margin-top:8px;
    color:var(--muted);
    font-size:12px;
}

/* ================= CONTENT GRID ================= */

.content-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:22px;
}

.card{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:24px;
    box-shadow:var(--shadow);
    margin-bottom:22px;
}

.card.full{
    grid-column:1 / -1;
}

.card-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    margin-bottom:20px;
    padding-bottom:15px;
    border-bottom:1px solid var(--border);
}

.card-title{
    font-size:18px;
    font-weight:900;
    color:var(--navy);
}

.card-subtitle{
    font-size:12px;
    color:var(--muted);
    margin-top:4px;
}

/* ================= PROFILE ================= */

.profile-top{
    display:flex;
    align-items:center;
    gap:15px;
    margin-bottom:20px;
}

.avatar{
    width:58px;
    height:58px;
