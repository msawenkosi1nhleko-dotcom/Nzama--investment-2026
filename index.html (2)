*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --navy:#071426;
    --navy2:#0d1f38;
    --gold:#d6ad55;
    --gold2:#f0cf7a;
    --white:#ffffff;
    --light:#f5f7fa;
    --text:#172033;
    --muted:#6b7280;
    --border:#e5e7eb;
    --green:#17834d;
    --shadow:0 12px 35px rgba(7,20,38,.12);
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,Arial,sans-serif;
    background:var(--light);
    color:var(--text);
    line-height:1.6;
}

/* ================= NAVIGATION ================= */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(7,20,38,.98);
    border-bottom:1px solid rgba(214,173,85,.25);
    box-shadow:0 5px 20px rgba(0,0,0,.12);
}

.nav-inner{
    max-width:1250px;
    min-height:76px;
    margin:auto;
    padding:0 22px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
    color:white;
    text-decoration:none;
}

.logo{
    width:45px;
    height:45px;
    border-radius:12px;
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:var(--navy);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:17px;
    font-weight:900;
}

.brand-name{
    font-size:18px;
    font-weight:900;
    letter-spacing:.8px;
}

.brand-sub{
    color:#aeb9c8;
    font-size:10px;
    letter-spacing:1.7px;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:5px;
}

.nav-links a{
    color:#dfe6ef;
    text-decoration:none;
    padding:11px 15px;
    border-radius:9px;
    font-size:14px;
    font-weight:700;
    transition:.2s;
}

.nav-links a:hover{
    background:rgba(255,255,255,.08);
    color:white;
}

.nav-login{
    border:1px solid rgba(214,173,85,.55);
    color:var(--gold2)!important;
}

.nav-register{
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:var(--navy)!important;
}

.menu-btn{
    display:none;
    background:transparent;
    color:white;
    border:1px solid rgba(255,255,255,.2);
    border-radius:8px;
    padding:8px 12px;
    font-size:20px;
}

/* ================= HERO ================= */

.hero{
    min-height:620px;
    background:
        radial-gradient(circle at 80% 20%,rgba(214,173,85,.16),transparent 30%),
        linear-gradient(120deg,#071426,#102947);
    color:white;
    display:flex;
    align-items:center;
}

.hero-inner{
    max-width:1250px;
    width:100%;
    margin:auto;
    padding:80px 22px;
    display:grid;
    grid-template-columns:1.15fr .85fr;
    gap:60px;
    align-items:center;
}

.eyebrow{
    color:var(--gold2);
    font-size:12px;
    font-weight:900;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:14px;
}

.hero h1{
    font-size:54px;
    line-height:1.08;
    max-width:700px;
    margin-bottom:20px;
}

.hero h1 span{
    color:var(--gold2);
}

.hero p{
    color:#c7d1df;
    max-width:650px;
    font-size:17px;
    line-height:1.75;
    margin-bottom:28px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    text-decoration:none;
    padding:14px 21px;
    border-radius:10px;
    font-size:14px;
    font-weight:900;
    transition:.2s;
}

.btn-primary{
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:var(--navy);
}

.btn-secondary{
    border:1px solid rgba(255,255,255,.3);
    color:white;
}

.btn:hover{
    transform:translateY(-2px);
}

.hero-card{
    background:rgba(255,255,255,.07);
    border:1px solid rgba(255,255,255,.14);
    border-radius:22px;
    padding:28px;
    backdrop-filter:blur(8px);
    box-shadow:0 20px 50px rgba(0,0,0,.2);
}

.hero-card-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.hero-card-title{
    font-size:13px;
    color:#b8c4d4;
    text-transform:uppercase;
    letter-spacing:1px;
    font-weight:800;
}

.live-dot{
    display:flex;
    align-items:center;
    gap:6px;
    color:#a9e5c5;
    font-size:11px;
}

.live-dot:before{
    content:"";
    width:7px;
    height:7px;
    border-radius:50%;
    background:#49c982;
}

.hero-number{
    font-size:38px;
    font-weight:900;
    color:white;
    margin-bottom:20px;
}

.hero-line{
    height:1px;
    background:rgba(255,255,255,.12);
    margin-bottom:18px;
}

.hero-mini-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.hero-mini{
    background:rgba(255,255,255,.05);
    border-radius:12px;
    padding:14px;
}

.hero-mini-label{
    color:#9eabbc;
    font-size:10px;
    text-transform:uppercase;
    font-weight:800;
}

.hero-mini-value{
    color:var(--gold2);
    font-size:17px;
    font-weight:900;
    margin-top:4px;
}

/* ================= NOTICE ================= */

.notice-wrap{
    max-width:1100px;
    margin:-35px auto 0;
    position:relative;
    z-index:5;
    padding:0 22px;
}

.notice{
    background:#fffaf0;
    border:1px solid #ead8a9;
    border-left:5px solid var(--gold);
    border-radius:14px;
    padding:18px 20px;
    color:#5d4a20;
    font-size:13px;
    line-height:1.6;
    box-shadow:var(--shadow);
}

/* ================= SECTION ================= */

.section{
    max-width:1250px;
    margin:auto;
    padding:90px 22px;
}

.section-heading{
    text-align:center;
    max-width:720px;
    margin:0 auto 45px;
}

.section-heading .eyebrow{
    color:#98762e;
}

.section-heading h2{
    color:var(--navy);
    font-size:36px;
    margin-bottom:12px;
}

.section-heading p{
    color:var(--muted);
}

/* ================= ABOUT ================= */

.about{
    background:white;
}

.about-grid{
    max-width:1250px;
    margin:auto;
    padding:90px 22px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:55px;
    align-items:center;
}

.about-box{
    background:linear-gradient(135deg,var(--navy),var(--navy2));
    color:white;
    border-radius:22px;
    padding:35px;
    min-height:330px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.about-mark{
    width:62px;
    height:62px;
    border-radius:16px;
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    color:var(--navy);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:900;
    font-size:22px;
    margin-bottom:22px;
}

.about-box h3{
    font-size:25px;
    margin-bottom:10px;
}

.about-box p{
    color:#c5d0df;
}

.about-content .eyebrow{
    color:#98762e;
}

.about-content h2{
    font-size:36px;
    color:var(--navy);
    line-height:1.2;
    margin-bottom:18px;
}

.about-content p{
    color:var(--muted);
    margin-bottom:15px;
}

/* ================= PLANS ================= */

.plans{
    background:#f5f7fa;
}

.plan-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.plan-card{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:24px;
    box-shadow:var(--shadow);
    transition:.2s;
}

.plan-card:hover{
    transform:translateY(-4px);
}

.plan-name{
    color:#98762e;
    font-size:12px;
    font-weight:900;
    letter-spacing:1.3px;
}

.plan-card h3{
    color:var(--navy);
    font-size:22px;
    margin:7px 0 15px;
}

.plan-amount{
    font-size:25px;
    font-weight:900;
    color:var(--navy);
}

.plan-duration{
    color:var(--muted);
    font-size:12px;
    margin-top:4px;
}

.plan-card ul{
    list-style:none;
    margin:20px 0;
}

.plan-card li{
    padding:8px 0;
    border-bottom:1px solid #f0f1f3;
    font-size:12px;
    color:#566071;
}

.plan-card li:last-child{
    border-bottom:0;
}

.plan-button{
    display:block;
    text-align:center;
    text-decoration:none;
    background:var(--navy);
    color:white;
    padding:11px;
    border-radius:9px;
    font-size:12px;
    font-weight:900;
}

/* ================= HOW IT WORKS ================= */

.steps{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.step{
    background:white;
    border:1px solid var(--border);
    border-radius:17px;
    padding:26px;
    box-shadow:var(--shadow);
}

.step-number{
    width:42px;
    height:42px;
    border-radius:50%;
    background:#f5ead0;
    color:#8b6828;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:900;
    margin-bottom:17px;
}

.step h3{
    color:var(--navy);
    margin-bottom:8px;
}

.step p{
    color:var(--muted);
    font-size:13px;
}

/* ================= CTA ================= */

.cta{
    background:linear-gradient(120deg,var(--navy),var(--navy2));
    color:white;
    text-align:center;
}

.cta-inner{
    max-width:800px;
    margin:auto;
    padding:90px 22px;
}

.cta h2{
    font-size:38px;
    margin-bottom:12px;
}

.cta p{
    color:#c4cfdd;
    margin-bottom:25px;
}

/* ================= FOOTER ================= */

footer{
    background:#050d19;
    color:#9da9b8;
    padding:45px 22px 25px;
}

.footer-inner{
    max-width:1250px;
    margin:auto;
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr;
    gap:40px;
    padding-bottom:35px;
}

.footer-title{
    color:white;
    font-size:17px;
    font-weight:900;
    margin-bottom:10px;
}

.footer-heading{
    color:var(--gold2);
    font-weight:900;
    margin-bottom:10px;
}

footer p,
footer a{
    font-size:12px;
    color:#9da9b8;
    text-decoration:none;
}

.footer-bottom{
    max-width:1250px;
    margin:auto;
    padding-top:20px;
    border-top:1px solid rgba(255,255,255,.08);
    text-align:center;
    font-size:11px;
}

/* ================= MOBILE ================= */

@media(max-width:950px){

    .hero-inner{
        grid-template-columns:1fr;
        gap:35px;
    }

    .hero h1{
        font-size:43px;
    }

    .plan-grid{
        grid-template-columns:1fr 1fr;
    }

    .about-grid{
        grid-template-columns:1fr;
    }

    .footer-inner{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:700px){

    .nav-inner{
        min-height:68px;
    }

    .brand-sub{
        display:none;
    }

    .brand-name{
        font-size:15px;
    }

    .logo{
        width:40px;
        height:40px;
    }

    .menu-btn{
        display:block;
    }

    .nav-links{
        position:absolute;
        left:0;
        right:0;
        top:68px;
        background:var(--navy);
        display:none;
        flex-direction:column;
        align-items:stretch;
        padding:10px 15px 15px;
    }

    .nav-links.open{
        display:flex;
    }

    .nav-links a{
        width:100%;
    }

    .hero{
        min-height:auto;
    }

    .hero-inner{
        padding:65px 18px;
    }

    .hero h1{
        font-size:36px;
    }

    .hero p{
        font-size:15px;
    }

    .hero-card{
        padding:21px;
    }

    .section{
        padding:65px 18px;
    }

    .section-heading h2,
    .about-content h2{
        font-size:29px;
    }

    .plan-grid,
    .steps{
        grid-template-columns:1fr;
    }

    .about-grid{
        padding:65px 18px;
    }

    .footer-inner{
        grid-template-columns:1fr;
        gap:25px;
    }

    .cta-inner{
        padding:65px 18px;
    }

    .cta h2{
        font-size:30px;
    }
}
